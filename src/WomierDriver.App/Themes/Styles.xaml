<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WomierDriver.App.Converters">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
  <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
  <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
  <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />
  <conv:ZeroToVisibilityConverter x:Key="NonZeroToVisible" Invert="True" />

  <!-- Cards: the Windows 11 settings-page building block. -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SecondaryBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Small rounded badges ("Default", "Active"). -->
  <Style x:Key="BadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.FontSize" Value="11" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="AccentBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>

  <!-- Quick-select chips above the keyboard. -->
  <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Icon-only buttons: the content is a Segoe Fluent Icons code point (e.g. &#xE712;). The icon font is applied
       to the glyph through the content template, never to the button itself: a button's FontFamily is inherited
       by its ToolTip and ContextMenu popups, which would then render their text as icon glyphs. -->
  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Inline-editable title (profile name). -->
  <Style x:Key="InlineTitleTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="-7,0,0,0" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="ToolTip" Value="Click to rename" />
  </Style>

  <!-- Toggle switch look for CheckBox (supports the indeterminate state for mixed selections). -->
  <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True" />
            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1">
              <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                       Fill="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center" />
              <Setter TargetName="Thumb" Property="Margin" Value="0" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="14" />
              <Setter TargetName="Thumb" Property="Height" Value="14" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Profile list items. -->
  <Style x:Key="ProfileListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

</ResourceDictionary>
