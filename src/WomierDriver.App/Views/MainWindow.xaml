<Window x:Class="WomierDriver.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WomierDriver.App.Views"
        xmlns:vm="clr-namespace:WomierDriver.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Womier SK75 TMR" Width="1280" Height="880" MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/app.ico">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <Grid Grid.Column="0" Margin="16,14,8,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="8,2,8,14">
        <StackPanel Orientation="Horizontal">
          <Image Source="pack://application:,,,/Assets/app.ico" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Womier SK75 TMR" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryCaptionStyle}" />
          </StackPanel>
        </StackPanel>

        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
              <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding ActiveSummaryText}" Margin="16,3,0,0" Style="{StaticResource SecondaryCaptionStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Grid Grid.Row="1" Margin="8,0,8,6">
        <TextBlock Text="PROFILES" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="&#xE8B5;" Style="{StaticResource SubtleIconButtonStyle}" ToolTip="Import profile from file…" AutomationProperties.Name="Import profile" Command="{Binding ImportProfileCommand}" />
          <Button Content="&#xE710;" Style="{StaticResource SubtleIconButtonStyle}" ToolTip="New profile" AutomationProperties.Name="New profile" Command="{Binding NewProfileCommand}" />
        </StackPanel>
      </Grid>

      <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
               BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ProfileListBoxItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryCaptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Default" />
                </Border>
                <Border Style="{StaticResource AccentBadgeStyle}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Active" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="3" Margin="8,10,8,0">
        <CheckBox Content="Switch profiles automatically" IsChecked="{Binding AutoSwitchEnabled}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Stretch" Margin="0,6" />
        <CheckBox Content="Notify on profile switch" IsChecked="{Binding NotifyOnSwitch}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Stretch" Margin="0,6" />
        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Stretch" Margin="0,6" />
      </StackPanel>
    </Grid>

    <!-- ============ Content ============ -->
    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToCollapsed}}">
          <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="No profile yet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock Text="Create a profile to start configuring your keys." Style="{StaticResource SecondaryBodyStyle}" HorizontalAlignment="Center" />
          <Button Content="New profile" Command="{Binding NewProfileCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>

        <Grid Margin="24,18,24,14" Visibility="{Binding SelectedProfile, Converter={StaticResource NullToCollapsed}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InlineTitleTextBoxStyle}" HorizontalAlignment="Left" KeyDown="OnTitleKeyDown" />
              <TextBlock Text="{Binding SelectedProfile.StatusLine}" Style="{StaticResource SecondaryCaptionStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Activate on keyboard" Command="{Binding ActivateProfileCommand}" Style="{StaticResource AccentButtonStyle}"
                      Visibility="{Binding SelectedProfile.IsActive, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,0,8,0" />
              <Button Content="Write again" Command="{Binding ReapplyCommand}" ToolTip="Send this profile to the keyboard again"
                      Visibility="{Binding SelectedProfile.IsActive, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
              <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource IconButtonStyle}" ToolTip="More" AutomationProperties.Name="More" Click="OnMoreClick">
                <Button.ContextMenu>
                  <ContextMenu Placement="Bottom">
                    <MenuItem Header="Set as default profile" Command="{Binding SetDefaultCommand}" />
                    <MenuItem Header="Duplicate" Command="{Binding DuplicateProfileCommand}" />
                    <Separator />
                    <MenuItem Header="Read settings from keyboard" Command="{Binding ReadFromKeyboardCommand}" ToolTip="Copy the keyboard's current key settings into this profile" />
                    <MenuItem Header="Export to file…" Command="{Binding ExportProfileCommand}" />
                    <Separator />
                    <MenuItem Header="Delete profile" Command="{Binding DeleteProfileCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Keyboard -->
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16,12,16,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Select" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Content="All" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="All" />
                  <Button Content="WASD" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="WASD" />
                  <Button Content="Letters" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="Letters" />
                  <Button Content="Numbers" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="Numbers" />
                  <Button Content="F-row" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="F-row" />
                  <Button Content="Modifiers" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="Modifiers" />
                  <Button Content="Arrows" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="Arrows" />
                  <Button Content="None" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectGroupCommand}" CommandParameter="None" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="sensitive" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                  <Border x:Name="LegendBar" Width="70" Height="8" CornerRadius="4" Margin="6,0" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                  <TextBlock Text="deep" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
              <views:KeyboardView Grid.Row="1" x:Name="KeyboardCanvas" Keys="{Binding Keys}" SelectionChanged="OnKeySelectionChanged" MaxHeight="300" />
            </Grid>
          </Border>

          <!-- Editors -->
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Key settings -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="Key settings" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource SecondaryCaptionStyle}" />

                  <TextBlock Margin="0,18,0,0" Style="{StaticResource SecondaryBodyStyle}"
                             Visibility="{Binding Editor.HasSelection, Converter={StaticResource InverseBoolToVisibility}}"
                             Text="Click a key to edit it, drag a rectangle to select several, or use the Select buttons above. Hold Ctrl to add to the selection. Changes are saved and sent to the keyboard automatically while the profile is active." />

                  <StackPanel Margin="0,10,0,0" Visibility="{Binding Editor.HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <views:SettingSlider Label="Actuation point" Hint="Depth at which the key registers"
                                         Value="{Binding Editor.Actuation}" IsMixed="{Binding Editor.IsActuationMixed, Mode=TwoWay}"
                                         Minimum="{Binding Editor.Limits.TravelMin}" Maximum="{Binding Editor.Limits.TravelMax}" Step="{Binding Editor.Limits.StepMm}" />

                    <CheckBox Content="Rapid trigger" IsChecked="{Binding Editor.RapidTrigger}" IsThreeState="False"
                              Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,6"
                              ToolTip="Re-arm the key as soon as it moves up, and release it as soon as it moves up, instead of using fixed points" />

                    <StackPanel IsEnabled="{Binding Editor.RapidTriggerControlsEnabled}">
                      <views:SettingSlider Label="RT press sensitivity" Hint="Downward travel to (re)trigger"
                                           Value="{Binding Editor.RtPress}" IsMixed="{Binding Editor.IsRtPressMixed, Mode=TwoWay}"
                                           Minimum="{Binding Editor.Limits.RtMin}" Maximum="{Binding Editor.Limits.RtMax}" Step="{Binding Editor.Limits.StepMm}" />
                      <views:SettingSlider Label="RT release sensitivity" Hint="Upward travel to release"
                                           Value="{Binding Editor.RtRelease}" IsMixed="{Binding Editor.IsRtReleaseMixed, Mode=TwoWay}"
                                           Minimum="{Binding Editor.Limits.RtMin}" Maximum="{Binding Editor.Limits.RtMax}" Step="{Binding Editor.Limits.StepMm}" />
                    </StackPanel>

                    <Expander Header="Advanced" Margin="0,10,0,0" IsExpanded="False">
                      <StackPanel Margin="0,6,0,0">
                        <views:SettingSlider Label="Release point" Hint="Reset depth when rapid trigger is off"
                                             Value="{Binding Editor.Release}" IsMixed="{Binding Editor.IsReleaseMixed, Mode=TwoWay}"
                                             Minimum="{Binding Editor.Limits.TravelMin}" Maximum="{Binding Editor.Limits.TravelMax}" Step="{Binding Editor.Limits.StepMm}" />
                        <views:SettingSlider Label="Bottom dead zone" Hint="Travel ignored near the bottom"
                                             Value="{Binding Editor.DeadZone}" IsMixed="{Binding Editor.IsDeadZoneMixed, Mode=TwoWay}"
                                             Minimum="{Binding Editor.Limits.DeadZoneMin}" Maximum="{Binding Editor.Limits.DeadZoneMax}" Step="{Binding Editor.Limits.StepMm}" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- Games -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Games" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Grid.Row="1" Style="{StaticResource SecondaryCaptionStyle}" Text="This profile is applied while any of these processes is running." />

                <Grid Grid.Row="2" Margin="0,10,0,0">
                  <TextBlock Style="{StaticResource SecondaryBodyStyle}" VerticalAlignment="Top" Margin="0,4,0,0"
                             Visibility="{Binding SelectedProfile.HasGames, Converter={StaticResource InverseBoolToVisibility}}"
                             Text="No games yet. Add the game's process name (for example bf6.exe) or pick it from the running processes." />
                  <ItemsControl ItemsSource="{Binding SelectedProfile.Games}" Visibility="{Binding SelectedProfile.HasGames, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <ItemsPresenter />
                        </ScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4,4,4" Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource SubtleIconButtonStyle}" FontSize="11" MinHeight="26" MinWidth="26" Padding="6,3" AutomationProperties.Name="Remove"
                                    ToolTip="Remove" Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewGameText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnGameTextKeyDown" ToolTip="Process name, e.g. bf6.exe" />
                    <Button Grid.Column="1" Content="Add" Command="{Binding AddGameCommand}" Margin="8,0,0,0" />
                  </Grid>
                  <Button Content="Pick from running processes…" Command="{Binding PickRunningProcessCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Status line -->
          <Grid Grid.Row="3" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal">
              <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                           Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding LastApplyText}" Style="{StaticResource SecondaryCaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryCaptionStyle}" Text="Closing this window keeps the driver running in the tray" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
