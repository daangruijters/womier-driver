<UserControl x:Class="WomierDriver.App.Views.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WomierDriver.App.ViewModels"
             x:Name="Root">
  <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid x:Name="Surface" Width="732" Height="281" Background="Transparent"
          MouseLeftButtonDown="OnSurfaceMouseDown" MouseMove="OnSurfaceMouseMove" MouseLeftButtonUp="OnSurfaceMouseUp"
          MouseRightButtonDown="OnSurfaceRightClick">
      <ItemsControl ItemsSource="{Binding Keys, ElementName=Root}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:KeyViewModel}">
            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="5"
                    Background="{Binding Fill}" BorderBrush="{Binding Stroke}" BorderThickness="{Binding StrokeThickness}"
                    Cursor="Hand" Tag="{Binding}" SnapsToDevicePixels="True">
              <Border.ToolTip>
                <TextBlock>
                  <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                  <LineBreak />
                  <Run Text="Actuation " /><Run Text="{Binding ValueText, Mode=OneWay}" /><Run Text=" mm" />
                </TextBlock>
              </Border.ToolTip>
              <Grid>
                <!-- Live view: depth bar growing from the bottom, and the actuation point of the selected profile. -->
                <Rectangle Margin="1" RadiusX="4" RadiusY="4" Fill="{Binding Foreground}" Opacity="{Binding BarOpacity}"
                           IsHitTestVisible="False" RenderTransformOrigin="0.5,1">
                  <Rectangle.RenderTransform>
                    <ScaleTransform ScaleY="{Binding DepthFraction}" />
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="8" Height="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{Binding ActuationMarkerMargin}"
                           Fill="{Binding Foreground}" Opacity="0.9" IsHitTestVisible="False"
                           Visibility="{Binding ShowActuationMarker, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Margin="4,3,0,0"
                           Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ValueText}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="{Binding ValueMargin}" Foreground="{Binding Foreground}" Opacity="0.85" />
                <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                         Fill="{DynamicResource SystemFillColorSuccessBrush}"
                         Visibility="{Binding ShowRapidTrigger, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="Rapid trigger on" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Canvas IsHitTestVisible="False">
        <Rectangle x:Name="Marquee" Visibility="Collapsed" StrokeThickness="1" RadiusX="3" RadiusY="3"
                   Stroke="{DynamicResource AccentFillColorDefaultBrush}" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.35" />
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>
