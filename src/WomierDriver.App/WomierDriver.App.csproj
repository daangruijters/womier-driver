<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WomierDriver.App</RootNamespace>
    <AssemblyName>WomierDriver</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs the Velopack hooks before WPF starts. -->
    <StartupObject>WomierDriver.App.Program</StartupObject>
    <!-- WPF0001: the Fluent ThemeMode API is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Description>System-tray driver and configuration utility for the Womier SK75 TMR keyboard.</Description>
    <!-- Publishing produces one executable. Releases pack the self-contained publish output with Velopack
         (docs/releasing.md); it is left uncompressed so the delta updates between versions stay small. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WomierDriver.Core\WomierDriver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-offline.ico" />
  </ItemGroup>

</Project>
